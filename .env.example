# Loom Code — environment variables for API keys
# Copy this file to .env and fill in your keys, or set them as env vars.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, o1, etc.)
OPENAI_API_KEY=

# NVIDIA NIM / Integrate API
NVIDIA_API_KEY=
# Optional: override NVIDIA base URL (defaults to https://integrate.api.nvidia.com/v1)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Gemini
GOOGLE_API_KEY=
# Optional: enable Google browser sign-in with your own OAuth client
# LOOM_GOOGLE_OAUTH_CLIENT_ID=
# LOOM_GOOGLE_OAUTH_CLIENT_SECRET=

# OpenRouter (optional)
OPENROUTER_API_KEY=

# Web search (optional; keyless SearXNG/DuckDuckGo/Wikipedia work without these)
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# Self-hosted SearXNG (JSON API enabled at /search?format=json)
# SEARXNG_URL=http://127.0.0.1:8080
# SEARXNG_INSTANCES=https://searx.example,https://searx.example2

# Auth vault (optional)
# Passphrase instead of the local auth.key file (scrypt)
# LOOM_AUTH_KEY=
# Disable the Windows DPAPI wrapper around auth.key (encryption stays on)
# LOOM_AUTH_NO_DPAPI=1

# Loom Code debug logging
# LOOM_DEBUG=1

# Skip update check on startup
# LOOM_NO_UPDATE_CHECK=1