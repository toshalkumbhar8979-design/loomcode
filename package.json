    "@opentui/core-linux-arm64": "0.5.3",
    "@opentui/core-linux-x64": "0.5.3",
    "@opentui/core-win32-x64": "0.5.3"
  },
  "overrides": {
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "bunfig.toml",
    "tsconfig.json",
    "bin/loom-bun.js",
    "bin/loom.js",
    "bin/loom-tui.js",
    "src/**/*.js",
    "src/**/*.tsx",
    "src/**/*.ts",
    "!src/**/test-*",
    "!src/**/*.test.*",
    "!src/test-loop.js",
