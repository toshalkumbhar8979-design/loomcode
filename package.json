    "loom-code",
    "anthropic",
    "openai",
    "nvidia",
    "terminal",
    "opentui"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
